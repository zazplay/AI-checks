# Backend environment

# App
PORT=3000
NODE_ENV=development

# API auth — single demo user. POST /auth/login with these credentials
# returns a JWT; every endpoint except /health and /auth/login requires it.
# Leave AUTH_PASSWORD empty to disable auth (local dev convenience).
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_URL=postgres://invoice:invoice@localhost:5432/invoices
# On a deploy (NODE_ENV=production) the schema auto-create is off by default;
# set DB_SYNCHRONIZE=true on a FRESH managed DB so tables are created (no
# migrations in this project). Set DB_SSL=true for managed Postgres that
# requires SSL (Railway/Render/Neon/Supabase).
DB_SYNCHRONIZE=false
DB_SSL=false

# Redis (async processing / queues)
# Local dev uses host/port. On a managed Redis (Railway/Render) set REDIS_URL
# instead — it bundles host, port and password; it takes precedence when present.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://default:password@host:6379
# REDIS_PASSWORD=

# Extraction worker throughput — the backend processing queue that protects the
# AI provider's free-tier quota when many invoices are uploaded at once.
#   EXTRACTION_CONCURRENCY    — how many invoices extract in parallel.
#   EXTRACTION_RATE_MAX       — max jobs started per window (rest are parked as
#                               rate-limited, NOT failed — no quota wasted).
#   EXTRACTION_RATE_DURATION_MS — the rate-limit window in ms.
# Defaults below suit free-tier Gemini/Groq; raise them for a paid key.
EXTRACTION_CONCURRENCY=2
EXTRACTION_RATE_MAX=8
EXTRACTION_RATE_DURATION_MS=60000

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Storage backend for the original uploaded files.
#   STORAGE_DRIVER=disk -> local disk under UPLOAD_DIR (default; great for dev).
#   STORAGE_DRIVER=s3   -> an S3-compatible bucket (e.g. Cloudflare R2) for a
#                          deploy with no persistent disk.
# For S3/R2 fill the values below (kept out of git via .gitignore). The R2
# endpoint is https://<account_id>.r2.cloudflarestorage.com — create a bucket and
# an S3 API token at https://dash.cloudflare.com/?to=/:account/r2
STORAGE_DRIVER=disk
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- AI providers -----------------------------------------------------------
# Configure at least ONE of Claude or Gemini (both do vision extraction). Each
# provider is enabled only when its API key is present. Extraction runs a
# fallback cascade across the configured engines; the assistant chat picks the
# best available engine. All keys are optional, but with none set the AI
# features (extraction + assistant) won't work.

# Google Gemini — vision extraction (PDF/image) AND optional assistant chat.
# Free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (claude-haiku-4-5) — DEFAULT primary extraction engine and a
# capable assistant engine. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq — assistant chat (big free quota ~14.4k req/day) and the text-only
# extraction fallback (GPT over a PDF's text layer). No vision.
# Get a key at https://console.groq.com (API Keys → Create).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Primary extraction engine (tried first in the cascade): claude-haiku-4-5
# (default) or a Gemini model id. Others remain as fallbacks. Also switchable
# at runtime via PUT /ai/model.
EXTRACTION_MODEL=claude-haiku-4-5

# Force the default assistant chat engine: gemini | groq | claude.
# Empty = auto (prefers Groq when its key is set, else Claude, else Gemini).
# Also switchable at runtime via PUT /ai/assistant-engine.
ASSISTANT_PROVIDER=
